# --- Supabase ---
# Panel de Supabase → Project Settings → Database
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres"

# Panel de Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT_REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="..."
SUPABASE_SERVICE_ROLE_KEY="..." # NUNCA exponer al cliente, solo uso server-side

# --- Microsoft Entra ID (Azure AD) ---
# Pendiente de acceso de IT al tenant — se usará en Microsoft Graph (Fase 5)
# y, si se consigue acceso más adelante, para sustituir el login por
# contraseña de /admin por login real con Microsoft.
AZURE_AD_CLIENT_ID=""
AZURE_AD_CLIENT_SECRET=""
AZURE_AD_TENANT_ID=""

# --- Acceso a /admin (interino, mientras no hay Azure AD) ---
# Genera un secreto con: openssl rand -base64 33
AUTH_SECRET=""
# Contraseña compartida para entrar a /admin
ADMIN_PASSWORD=""

# --- Email (Fase 5, alternativa sin Azure AD) ---
# SMTP genérico — funciona igual con Gmail (smtp.gmail.com, puerto 587,
# contraseña de aplicación) o con Outlook personal (smtp.office365.com,
# puerto 587). Usa una contraseña de aplicación, nunca tu contraseña normal.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM_NAME="Premios Nerea"
SMTP_FROM_EMAIL=""

# --- Google Drive (Fase 5, backup de resultados) ---
# console.cloud.google.com → APIs y servicios → Credenciales → ID de
# cliente OAuth (tipo Aplicación web). URI de redirección autorizada:
# {NEXT_PUBLIC_SITE_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Se rellena solo la primera vez, tras conectar desde /admin/resultados
GOOGLE_REFRESH_TOKEN=""

# --- Entorno ---
NEXT_PUBLIC_ACTIVE_EVENT_SLUG="premios-nerea"
# Dominio público de la app — se usa para construir los enlaces de voto que
# se mandan por email. Cámbialo cuando despliegues a un dominio real.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
