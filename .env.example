# --- Supabase ---
# Panel de Supabase → Project Settings → Database
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres"

# Panel de Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT_REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="..."
SUPABASE_SERVICE_ROLE_KEY="..." # NUNCA exponer al cliente, solo uso server-side

# --- Microsoft Entra ID (Azure AD) ---
# Pendiente de acceso de IT al tenant — se usará en Microsoft Graph (Fase 5)
# y, si se consigue acceso más adelante, para sustituir el login por
# contraseña de /admin por login real con Microsoft.
AZURE_AD_CLIENT_ID=""
AZURE_AD_CLIENT_SECRET=""
AZURE_AD_TENANT_ID=""

# --- Acceso a /admin (interino, mientras no hay Azure AD) ---
# Genera un secreto con: openssl rand -base64 33
AUTH_SECRET=""
# Contraseña compartida para entrar a /admin
ADMIN_PASSWORD=""

# --- Entorno ---
NEXT_PUBLIC_ACTIVE_EVENT_SLUG="premios-nerea"
